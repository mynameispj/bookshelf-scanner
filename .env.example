# Your OpenAI API key (required for book spine recognition)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Port for the web server (optional, defaults to 3000)
PORT=3000

# Google Books API key (optional). Used by the catalog check alongside Open Library.
# Without a key Google Books often answers "rate limited", which the app treats as
# "unknown" (no penalty). Create one at https://console.cloud.google.com/apis/credentials
# and enable the "Books API".
GOOGLE_BOOKS_API_KEY=

# Bot protection on the paid endpoints (optional): enforce (default) | log | off
BOTID_MODE=enforce

# Models (optional). Photos need full GPT-4o; the text-only steps (title/author
# check and "Fix it by describing it") use the much cheaper GPT-4o mini.
# Set OPENAI_MODEL_TEXT=gpt-4o to switch those back.
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MODEL_TEXT=gpt-4o-mini

# Estimated USD per 1M tokens [input, output], used only for the cost estimate in
# the "scan_usage"/"fix_usage" log lines (optional; defaults are list prices:
# gpt-4o 2.5/10, gpt-4o-mini 0.15/0.60)
# OPENAI_PRICES={"gpt-4o":[2.5,10],"gpt-4o-mini":[0.15,0.6]}
