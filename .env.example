# Your OpenAI API key (required for book spine recognition)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Port for the web server (optional, defaults to 3000)
PORT=3000

# Google Books API key (optional). Used by the catalog check alongside Open Library.
# Without a key Google Books often answers "rate limited", which the app treats as
# "unknown" (no penalty). Create one at https://console.cloud.google.com/apis/credentials
# and enable the "Books API".
GOOGLE_BOOKS_API_KEY=
